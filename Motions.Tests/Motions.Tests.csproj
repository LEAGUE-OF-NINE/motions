<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>Motions.Tests</RootNamespace>
    <AssemblyName>Motions.Tests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- Links plugin source files that must never reference UnityEngine or interop
         types; if one starts to, this project stops compiling, which is the point. -->
    <Compile Include="..\Motions\SpriteMotionSpec.cs" Link="SpriteMotionSpec.cs" />
    <Compile Include="..\Motions\PropSpec.cs" Link="PropSpec.cs" />
  </ItemGroup>
</Project>
